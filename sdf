# Параметры
$SmtpServer = "11.0.0.3"   # IP или имя вашего Postfix сервера
$SmtpPort   = 25           # Стандартный порт SMTP
$From       = "test@mail.ru"
$To         = "director@demo.lab" 
$Subject    = "Тестовое письмо с вложением"
$Body       = "Привет! Во вложении находится тестовый файл."

# Путь к файлу для вложения (укажите свой путь)
$AttachmentPath = "C:\Temp\test.txt" 

# Проверка, существует ли файл (чтобы скрипт не падал втихую)
if (-not (Test-Path -Path $AttachmentPath)) {
    Write-Host "Ошибка: Файл по пути $AttachmentPath не найден!" -ForegroundColor Red
    exit
}

# Отправка
try {
    Send-MailMessage -SmtpServer $SmtpServer `
                     -Port $SmtpPort `
                     -From $From `
                     -To $To `
                     -Subject $Subject `
                     -Body $Body `
                     -Attachments $AttachmentPath `
                     -Encoding UTF8
    Write-Host "Письмо с вложением успешно отправлено!" -ForegroundColor Green
} catch {
    Write-Host "Ошибка при отправке: $_" -ForegroundColor Red
}
